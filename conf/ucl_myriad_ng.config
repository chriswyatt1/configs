// UCL Myriad (Myriad-ng: RHEL9 + Slurm)
//
// Myriad is being migrated from SGE to Slurm ("Myriad-ng", login via
// myriad-ng.rc.ucl.ac.uk). This profile targets the Slurm side; the
// `ucl_myriad` profile still covers the original SGE side.
// Docs: https://www.rc.ucl.ac.uk/docs/Supplementary/Slurm/
//
// Myriad only runs single-node jobs. General-access node types in Myriad-ng:
//   D: 36 cores, 160 GB usable RAM
//   B: 36 cores, 1483 GB usable RAM
//   E: 36 cores, 160 GB usable RAM, 2x V100 (GPU)
//   L: 36 cores, 160 GB usable RAM, 4x A100 40G (GPU)

params {
    config_profile_description = 'University College London Myriad cluster (Myriad-ng, Slurm)'
    config_profile_contact     = 'Chris Wyatt (ucbtcdr@ucl.ac.uk), Fernando Duarte (f.frutos@ucl.ac.uk)'
    config_profile_url         = 'https://www.rc.ucl.ac.uk/docs/Clusters/Myriad/'
}

executor {
    name            = 'slurm'
    queueSize       = 100     // Limit number of jobs queued at once (in case the user runs more than one pipeline)
    submitRateLimit = '10/1s' // Submit max 10 jobs per second, to ease pressure on the scheduler
}

process {
    // `myriad` is the default (CPU) partition; GPU nodes are in `gpu`.
    // Time limits are set by QOS, not by the partitions.
    queue          = 'myriad'

    // Users have no default QOS, so one is set per job:
    //   1cpu72h    - single-core jobs, up to 72 h
    //   highcpu48h - multi-core jobs, up to 48 h
    //   freegpu    - GPU jobs, up to 48 h
    // Slurm only gives each job a 100 MiB $TMPDIR unless more is requested (--gres=tmpfs).
    clusterOptions = { "--qos=${task.cpus == 1 ? '1cpu72h' : 'highcpu48h'} --gres=tmpfs:10G" }
    scratch        = false

    resourceLimits = [
        cpus: 36,
        memory: 1483.GB, // B-type high-memory nodes; D nodes have 160 GB
        time: 48.h,      // highcpu48h limit (single-core jobs could run for 72 h)
    ]

    withLabel: 'process_gpu' {
        // Lands on either E (V100) or L (A100) nodes. Use `--gres=gpu:v100:1` or `--gres=gpu:a100:1` to pick one.
        queue            = 'gpu'
        clusterOptions   = '--qos=freegpu --gres=gpu:1,tmpfs:20G'
        containerOptions = '--nv'
    }
}

apptainer {
    enabled    = true
    autoMounts = true
    cacheDir   = "${System.getenv('HOME')}/Scratch/.apptainer/pull"
    runOptions = "-B ${System.getenv('HOME')},${System.getenv('PWD')} --no-mount /scratch --writable-tmpfs"
}
